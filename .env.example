# aiproxy — все переменные окружения.
# Скопируйте файл в .env и отредактируйте под свою среду.
# Настройки провайдеров сюда НЕ входят: они живут в providers.json.

# ── Сервер ──
COPILOT2API_HOST=127.0.0.1        # адрес (по умолчанию 127.0.0.1)
COPILOT2API_PORT=7777             # порт (по умолчанию 7777)

# ── Хранилище токенов ──
# Здесь лежат credentials.json (Copilot), openai-credentials.json (OpenAI)
# и подкаталог claude/ с входом Claude Code CLI.
COPILOT2API_TOKEN_DIR=~/.config/copilot2api

# ── Логирование процесса ──
COPILOT2API_DEBUG=false           # true — отладочные логи

# ── Журнал запросов ──
# Сводки пишутся всегда; тела — только при включённом AIPROXY_LOG_BODIES.
AIPROXY_LOG_DIR=logs
AIPROXY_LOG_BODIES=false          # тела запросов/ответов; включается сам при COPILOT2API_DEBUG=true
AIPROXY_LOG_BODY_LIMIT=32768      # потолок одной строки тела, байт (голова + маркер + хвост)
AIPROXY_LOG_BODY_BUDGET_MB=512    # потолок тел на сутки, МБ; дальше тела не пишутся до смены суток
AIPROXY_LOG_PROBES=false          # писать пробы (/v1/models, /props, /api/tags …) — по умолчанию отфильтрованы
AIPROXY_LOG_RETENTION_DAYS=14     # старше N дней — в .zst, старше 2N — удалить
AIPROXY_LOG_RETENTION_INTERVAL=24h # период фоновой уборки
AIPROXY_LOG_MAX_SIZE=20G          # потолок всего каталога журнала (20G, 20480M, байты)
AIPROXY_LOG_INDEX=true            # индекс сводок в logs/index.sqlite (нужен для -stats и /admin/stats)

# ── Claude Code CLI (провайдер type: "claude-cli") ──
# CLAUDE_CLI_PATH=/usr/local/bin/claude   # путь к бинарю, если его нет в PATH сервиса
# CLAUDE_CLI_TIMEOUT=180s                 # пауза молчания дочернего CLI (Go-duration)

# ── AmpCode: локальный режим ──
AMP_THREADS_DIR=~/.config/copilot2api/threads
